{
  "name": "@dsh-desktop/title-bar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom title bar for the dsh desktop app",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
